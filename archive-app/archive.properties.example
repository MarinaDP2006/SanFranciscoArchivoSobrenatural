# Copia este archivo como "archive.properties" junto al .jar (o en archive-app/)
# para cambiar la conexión sin recompilar. También valen variables de entorno:
#   SFA_DB_URL, SFA_DB_USER, SFA_DB_PASSWORD, PORT (API)

# Aplicación de escritorio (usuario MySQL con permisos de gestión)
db.url=jdbc:mysql://localhost:3306/sf_archive?useUnicode=true&characterEncoding=UTF-8
db.user=sfa_admin
db.password=sfa_admin_2026

# API pública que alimenta la web (usuario MySQL de solo lectura + avisos)
api.db.user=sfa_web
api.db.password=sfa_web_2026
api.port=8080
web.dir=../archive-web/public
